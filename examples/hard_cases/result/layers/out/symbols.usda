            string aeco:derived:source = "c90c7a46-7416-54ce-9f21-df7eb4ec1752"
            string aeco:derived:stamp = "core hierarchy symbols 0.9.2"
            double aeco:derived:tolerance = 0.000001
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
