#usda 1.0
(
    doc = "Schematic hierarchy symbols only. Sizes and positions are diagram layout, not surveyed geometry."
)

def "ReviewMaterials"
{
    def Material "Site"
    {
        token outputs:surface.connect = </ReviewMaterials/Site/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.2, 0.4, 0.65)
            color3f inputs:specularColor = (0, 0, 0)
            int inputs:useSpecularWorkflow = 1
            token outputs:surface
        }
    }

    def Material "Part"
    {
        token outputs:surface.connect = </ReviewMaterials/Part/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.25, 0.57, 0.37)
            color3f inputs:specularColor = (0, 0, 0)
            int inputs:useSpecularWorkflow = 1
            token outputs:surface
        }
    }

    def Material "Space"
    {
        token outputs:surface.connect = </ReviewMaterials/Space/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.22, 0.65, 0.67)
            color3f inputs:specularColor = (0, 0, 0)
            int inputs:useSpecularWorkflow = 1
            token outputs:surface
        }
    }

    def Material "Element"
    {
        token outputs:surface.connect = </ReviewMaterials/Element/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.85, 0.57, 0.2)
            color3f inputs:specularColor = (0, 0, 0)
            int inputs:useSpecularWorkflow = 1
            token outputs:surface
        }
    }

    def Material "Ink"
    {
        token outputs:surface.connect = </ReviewMaterials/Ink/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.01, 0.015, 0.02)
            color3f inputs:specularColor = (0, 0, 0)
            int inputs:useSpecularWorkflow = 1
            token outputs:surface
        }
    }

    def Material "Link"
    {
        token outputs:surface.connect = </ReviewMaterials/Link/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.35, 0.4, 0.45)
            color3f inputs:specularColor = (0, 0, 0)
            int inputs:useSpecularWorkflow = 1
            token outputs:surface
        }
    }
}

