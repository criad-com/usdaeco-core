        }
    )
}

class "AecoElementAPI" (
    customData = {
        string userDocBrief = "The universal marker for 'this prim is a built element' — a trait applied to any Imageable (Mesh, assembly, reference, future BREP), never a parallel typed hierarchy."
    }
)
{
    string aeco:id = "" (
        customData = {
            string userDocBrief = """Stable, globally unique element identity (lowercase
        hyphenated UUID recommended) — the interchange join key, the
        counterpart of IfcRoot.GlobalId in canonical form."""
        }
    )
    uniform token aeco:phase = "proposed" (
        allowedTokens = ["proposed", "existing", "demolished", "temporary"]
        customData = {
            string userDocBrief = """Lifecycle phase of the element with respect to this
        project (the asset clock, E12)."""
        }
    )
    rel aeco:referencedContainers (
        customData = {
            string userDocBrief = """Secondary spatial anchors: containers of ANY spatial
        type, in ANY facility, that this element serves or spans beyond
        its one primary container — a riser referencing upper levels, a
        skybridge referencing the other tower's part, a culvert serving
        the adjacent road section (the bijective counterpart of
        IfcRelReferencedInSpatialStructure)."""
        }
    )
}

