class "AecoDerivedGeometryAPI" (
    customData = {
        string userDocBrief = "Marks a gprim as DERIVED from a referent by a tool: the host's tessellated body, a stage-side proxy, the axis curve, a footprint, a symbol, a spatial extent or an analytic guide."
    }
)
{
    uniform token aeco:derived:approx = "exact" (
        allowedTokens = ["exact", "driverEval", "tessellated", "arcSegmented", "defaultDims", "bbox"]
        customData = {
            string userDocBrief = "exact: a kernel-evaluated body (BrepArray) or an analytic gprim."
        }
    )
    rel aeco:derived:from (
        customData = {
            string userDocBrief = """The gprim(s) this gprim was derived from, when it was derived
        from another representation rather than from the element itself: a
        tessellated Body targets its BodyExact; a baked wireframe targets the
        BodyExact it was extracted from."""
        }
    )
    uniform token aeco:derived:role = "body" (
        allowedTokens = ["body", "proxy", "axis", "footprint", "symbol", "extent", "sector", "coverage", "wireframe"]
        customData = {
            string userDocBrief = """What the gprim is a picture of: the element's body
        (purpose render), a stand-in (purpose proxy), the axis (purpose
        guide), a plan footprint, a symbol, a spatial extent (never an
        obstacle), an analytic view sector or analytic clipped coverage."""
        }
    )
    string aeco:derived:source = "" (
        customData = {
            string userDocBrief = "aeco:id of the element or spatial referent this gprim stands for."
        }
    )
    string aeco:derived:stamp = "" (
        customData = {
            string userDocBrief = "The deriving host or tool and its version."
        }
    )
    double aeco:derived:tolerance = 0 (
        customData = {
            string userDocBrief = """(m) The tolerance the derivation honoured: for approx = exact the
        kernel's modelling tolerance; for tessellated the linear deflection; 0 = unknown."""
        }
    )
}

