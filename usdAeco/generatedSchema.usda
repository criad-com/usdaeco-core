class AecoPort "AecoPort" (
    customData = {
        string userDocBrief = "A typed connection point on an element, authored as a child prim so it has a transform (the physical connection location) and can be targeted by relationships."
    }
)
{
    rel aeco:connectedPorts (
        customData = {
            string userDocBrief = """The AecoPort prim(s) this port is physically connected
        to."""
        }
    )
    uniform token aeco:flowDirection = "undefined" (
        allowedTokens = ["source", "sink", "bidirectional", "undefined"]
        customData = {
            string userDocBrief = """Direction of flow at this port relative to its owning
        element: 'source' emits, 'sink' receives, 'bidirectional' does
        both (IFC SOURCEANDSINK)."""
        }
    )
    string aeco:id = "" (
        customData = {
            string userDocBrief = """Stable unique identity (ports are addressable for
        commissioning and fabrication records)."""
        }
    )
    uniform token aeco:medium = "undefined" (
        allowedTokens = ["pipe", "duct", "cable", "cableCarrier", "wireless", "other", "undefined"]
        customData = {
            string userDocBrief = """What passes or connects at this port (vocabulary
        aligned with IfcDistributionPortTypeEnum)."""
        }
    )
    rel proxyPrim (
        customData = {
            string userDocBrief = '''The proxyPrim relationship allows us to link a
        prim whose purpose is "render" to its (single target)
        purpose="proxy" prim.'''
        }
    )
    uniform token purpose = "guide" (
        allowedTokens = ["default", "render", "proxy", "guide"]
        customData = {
            string userDocBrief = """Ports render as guide geometry by default (fallback
        override of UsdGeomImageable purpose): connection points are
        authoring/coordination aids, not model geometry, so vanilla
        viewers hide them unless guides are enabled."""
        }
    )
    token visibility = "inherited" (
        allowedTokens = ["inherited", "invisible"]
        customData = {
            string userDocBrief = '''Visibility is meant to be the simplest form of "pruning" 
        visibility that is supported by most DCC apps.'''
        }
    )
    uniform token[] xformOpOrder (
        customData = {
            string userDocBrief = """Encodes the sequence of transformation operations in the
        order in which they should be pushed onto a transform stack while
        visiting a UsdStage's prims in a graph traversal that will effect
        the desired positioning for this prim and its descendant prims."""
        }
    )
}

