        customData = {
            string userDocBrief = "Human-readable name of the classification entry."
        }
    )
    string aeco:class:__INSTANCE_NAME__:uri = "" (
        customData = {
            string userDocBrief = """Resolvable dictionary URI (bSDD recommended), pinning
        the exact system version."""
        }
    )
}

